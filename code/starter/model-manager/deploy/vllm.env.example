# /etc/vllm/vllm.env -- read by vllm.service (and rewritten by the model manager)
# Copy to /etc/vllm/vllm.env and fill in the key.

# Model to serve. Must already be in the HuggingFace cache (hf download <id>).
MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# Context window. 32768 fits a 7B model on the 24 GB L4 with room for a few
# concurrent conversations; the startup log's "GPU KV cache size" line tells
# you how many.
MAX_MODEL_LEN=32768

# Shared site key. Every client (Continue, the Module 4 backend, curl) sends
# it as:  Authorization: Bearer <key>
VLLM_API_KEY=change-me-to-the-site-key
